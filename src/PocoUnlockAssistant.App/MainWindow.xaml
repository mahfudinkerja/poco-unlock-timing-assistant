<Window x:Class="PocoUnlockAssistant.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="POCO Unlock Timing Assistant"
        Width="1320" Height="860" MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FF1A1A20" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FFC42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="MiniValue" TargetType="TextBlock" BasedOn="{StaticResource Value}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- ================= TITLE BAR ================= -->
        <Border Grid.Row="0" Background="#FF08080A" BorderBrush="#FF1A1A20" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="P" FontWeight="Bold" FontSize="13" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="POCO Unlock Timing Assistant" Margin="10,0,0,0" FontSize="12.5"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Pill}" Margin="14,0,0,0" Padding="9,2" VerticalAlignment="Center">
                        <TextBlock Text="HYPEROS 3 · POCO F7" Style="{StaticResource PillText}" FontSize="10" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="—" ToolTip="Minimize"
                            Click="OnMinimizeClick" />
                    <Button Style="{StaticResource CaptionButton}" Content="▢" ToolTip="Maximize"
                            Click="OnMaximizeClick" />
                    <Button Style="{StaticResource CloseButton}" Content="✕" ToolTip="Close"
                            Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= BODY ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation rail -->
            <Border Grid.Column="0" Background="#FF06060A" BorderBrush="#FF17171D" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="WORKSPACE" Style="{StaticResource Label}"
                               Margin="24,20,0,6" />

                    <ListBox Grid.Row="1" Style="{StaticResource NavList}"
                             ItemsSource="{Binding NavItems}"
                             SelectedIndex="{Binding SelectedSection, Mode=TwoWay}"
                             Margin="0,4" />

                    <StackPanel Grid.Row="2" Margin="24,0,24,18">
                        <Border Background="#FF0F0F14" BorderBrush="#FF1D1D24" BorderThickness="1"
                                CornerRadius="10" Padding="12,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EmergencyStopActive}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="EMERGENCY STOP" Style="{StaticResource PillText}" FontSize="10" />
                                </StackPanel>
                                <TextBlock Text="{Binding StateLabel}" Foreground="{StaticResource TextBrush}"
                                           FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0" />
                                <TextBlock Text="v0.1.0 · .NET 10" Style="{StaticResource PillText}"
                                           FontSize="10" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1">

                <!-- ============ DASHBOARD ============ -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsDashboard, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="26,22,26,26">

                        <Grid Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="MISSION CONTROL" Style="{StaticResource Label}"
                                           Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="POCO Unlock Timing Assistant" Style="{StaticResource PageTitle}"
                                           Margin="0,4,0,0" />
                                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"
                                           Text="Official Xiaomi Community authorization · controlled ADB · target 00:00:00 Asia/Shanghai" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                                                 Fill="{Binding SyncKind, Converter={StaticResource StatusBrush}}" />
                                        <TextBlock Style="{StaticResource PillText}">
                                            <Run Text="NTP " /><Run Text="{Binding SyncLabel, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Pill}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                                                 Fill="{Binding AdbKind, Converter={StaticResource StatusBrush}}" />
                                        <TextBlock Style="{StaticResource PillText}">
                                            <Run Text="ADB " /><Run Text="{Binding AdbStatus, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Device + time -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="DEVICE" Style="{StaticResource Label}" />
                                    <Grid Margin="0,12,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="46" Height="46" CornerRadius="12"
                                                    Background="{StaticResource AccentSoftBrush}">
                                                <TextBlock Text="F7" Foreground="{StaticResource AccentBrush}"
                                                           FontWeight="Bold" FontSize="15"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DeviceModel}" FontSize="17"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding DeviceDetail}"
                                                           Foreground="{StaticResource MutedBrush}" FontSize="11.5"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="240"
                                                           HorizontalAlignment="Left" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Style="{StaticResource Pill}" HorizontalAlignment="Right"
                                                VerticalAlignment="Top">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Margin="0,0,6,0"
                                                         VerticalAlignment="Center"
                                                         Fill="{Binding AdbKind, Converter={StaticResource StatusBrush}}" />
                                                <TextBlock Text="{Binding AdbStatus}"
                                                           Style="{StaticResource PillText}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <UniformGrid Columns="3" Margin="0,18,0,0">
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="HYPEROS" Style="{StaticResource Label}" />
                                            <TextBlock Text="{Binding HyperOsVersion}" Style="{StaticResource Value}"
                                                       FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="ANDROID" Style="{StaticResource Label}" />
                                            <TextBlock Text="{Binding AndroidVersion}" Style="{StaticResource Value}"
                                                       FontSize="12.5" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="USB" Style="{StaticResource Label}" />
                                            <TextBlock Text="{Binding UsbStatus}" Style="{StaticResource Value}"
                                                       FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="BATTERY" Style="{StaticResource Label}" />
                                            <TextBlock Text="{Binding BatteryStatus}" Style="{StaticResource Value}"
                                                       FontSize="12.5" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="SCREEN" Style="{StaticResource Label}" />
                                            <TextBlock Text="{Binding ScreenStatus}" Style="{StaticResource Value}"
                                                       FontSize="12.5" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="SERIAL" Style="{StaticResource Label}" />
                                            <TextBlock Text="{Binding SerialNumber}" Style="{StaticResource Value}"
                                                       FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="TIME" Style="{StaticResource Label}" />
                                        <Border Style="{StaticResource Pill}" HorizontalAlignment="Right"
                                                Padding="9,3">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Margin="0,0,6,0"
                                                         VerticalAlignment="Center"
                                                         Fill="{Binding SyncKind, Converter={StaticResource StatusBrush}}" />
                                                <TextBlock Text="{Binding SyncLabel}"
                                                           Style="{StaticResource PillText}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="BEIJING · ASIA/SHANGHAI" Style="{StaticResource Label}"
                                               Margin="0,14,0,2" />
                                    <TextBlock Text="{Binding BeijingTime}" FontFamily="{StaticResource MonoFont}"
                                               FontSize="34" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="{Binding BeijingDate}" Foreground="{StaticResource MutedBrush}"
                                               FontSize="11.5" />

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1.2*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="JAKARTA · WIB" Style="{StaticResource Label}" />
                                            <TextBlock Text="{Binding JakartaTime}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="18"
                                                       Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="{Binding JakartaDate}"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="10.5"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="WINDOWS LOCAL" Style="{StaticResource Label}" />
                                            <TextBlock Text="{Binding LocalTime}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="18"
                                                       Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="{Binding LocalDate}"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="10.5"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Background="#FF0B0B0E" BorderBrush="#FF1B1B21" BorderThickness="1"
                                            CornerRadius="10" Padding="12,10" Margin="0,16,0,0">
                                        <UniformGrid Columns="3" Rows="2">
                                            <StackPanel>
                                                <TextBlock Text="NTP SERVER" Style="{StaticResource Label}" />
                                                <TextBlock Text="{Binding NtpServer}" Style="{StaticResource Value}"
                                                           FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="OFFSET" Style="{StaticResource Label}" />
                                                <TextBlock Text="{Binding OffsetLabel}" Style="{StaticResource MonoValue}"
                                                           FontSize="11.5" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="UNCERTAINTY" Style="{StaticResource Label}" />
                                                <TextBlock Text="{Binding UncertaintyLabel}"
                                                           Style="{StaticResource MonoValue}" FontSize="11.5" />
                                            </StackPanel>
                                            <StackPanel Margin="0,8,0,0">
                                                <TextBlock Text="LATENCY" Style="{StaticResource Label}" />
                                                <TextBlock Text="{Binding LatencyLabel}" Style="{StaticResource MonoValue}"
                                                           FontSize="11.5" />
                                            </StackPanel>
                                            <StackPanel Margin="0,8,0,0">
                                                <TextBlock Text="LAST SYNC" Style="{StaticResource Label}" />
                                                <TextBlock Text="{Binding LastSyncLabel}"
                                                           Style="{StaticResource MonoValue}" FontSize="11.5" />
                                            </StackPanel>
                                            <StackPanel Margin="0,8,0,0">
                                                <TextBlock Text="TARGET" Style="{StaticResource Label}" />
                                                <TextBlock Text="{Binding TargetLabel}" Style="{StaticResource Value}"
                                                           FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </UniformGrid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Countdown -->
                        <Border Style="{StaticResource Card}" Background="#FF0A0A0D" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="COUNTDOWN TO QUOTA RESET" Style="{StaticResource Label}"
                                                   Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Text="·" Margin="8,0" Style="{StaticResource Label}" />
                                        <TextBlock Text="{Binding TargetLabel}" Style="{StaticResource Label}" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding CountdownDays}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="52"
                                                       FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="DAYS" Style="{StaticResource Label}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text=":" FontFamily="{StaticResource MonoFont}" FontSize="44"
                                                   Foreground="{StaticResource MutedBrush}" Margin="8,0"
                                                   VerticalAlignment="Top" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding CountdownHours}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="52"
                                                       FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="HOURS" Style="{StaticResource Label}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text=":" FontFamily="{StaticResource MonoFont}" FontSize="44"
                                                   Foreground="{StaticResource MutedBrush}" Margin="8,0"
                                                   VerticalAlignment="Top" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding CountdownMinutes}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="52"
                                                       FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="MINUTES" Style="{StaticResource Label}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text=":" FontFamily="{StaticResource MonoFont}" FontSize="44"
                                                   Foreground="{StaticResource MutedBrush}" Margin="8,0"
                                                   VerticalAlignment="Top" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding CountdownSeconds}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="52"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="SECONDS" Style="{StaticResource Label}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Bottom" Margin="10,0,0,22">
                                            <TextBlock Text="{Binding CountdownMillis}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="24"
                                                       Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Text="{Binding TargetWibLabel}" Foreground="{StaticResource MutedBrush}"
                                               FontSize="11.5" Margin="0,6,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                                    <Border Style="{StaticResource Pill}" Padding="12,7">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                                                     Fill="{Binding StateKind, Converter={StaticResource StatusBrush}}" />
                                            <TextBlock Text="{Binding StateLabel}" Style="{StaticResource PillText}"
                                                       Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding ModeLabel}" Foreground="{StaticResource MutedBrush}"
                                               FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Right" />
                                    <TextBlock Text="Monotonic timing · ms precision"
                                               Foreground="#FF5B5B66" FontSize="10.5" Margin="0,2,0,0"
                                               HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Execution status + readiness -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="1.15*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="EXECUTION STATUS" Style="{StaticResource Label}" />
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Mode"
                                                   Foreground="{StaticResource MutedBrush}" FontSize="12"
                                                   Margin="0,0,16,8" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ModeLabel}"
                                                   Style="{StaticResource Value}" FontSize="12" Margin="0,0,0,8" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Xiaomi Community"
                                                   Foreground="{StaticResource MutedBrush}" FontSize="12"
                                                   Margin="0,0,16,8" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CommunityStatus}"
                                                   Style="{StaticResource Value}" FontSize="12" Margin="0,0,0,8"
                                                   Foreground="{Binding CommunityKind, Converter={StaticResource StatusBrush}}" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Readiness"
                                                   Foreground="{StaticResource MutedBrush}" FontSize="12"
                                                   Margin="0,0,16,8" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ReadinessLabel}"
                                                   Style="{StaticResource Value}" FontSize="12" Margin="0,0,0,8"
                                                   Foreground="{Binding ReadinessKind, Converter={StaticResource StatusBrush}}" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Time sync"
                                                   Foreground="{StaticResource MutedBrush}" FontSize="12"
                                                   Margin="0,0,16,0" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SyncLabel}"
                                                   Style="{StaticResource Value}" FontSize="12"
                                                   Foreground="{Binding SyncKind, Converter={StaticResource StatusBrush}}" />
                                    </Grid>

                                    <Border Background="#FFF7200C" BorderBrush="#33FF4A1C" BorderThickness="1"
                                            CornerRadius="9" Padding="12,10" Margin="0,14,0,0">
                                        <TextBlock TextWrapping="Wrap" FontSize="11" LineHeight="17"
                                                   Foreground="#FFE0A090"
                                                   Text="Never a guaranteed instant: the app fires one verified action near the target and reports what Xiaomi actually answered. Keep this PC awake — Windows cannot execute while asleep." />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="READINESS CHECKS" Style="{StaticResource Label}" />
                                        <Button Content="Re-check" Style="{StaticResource GhostButton}"
                                                Padding="10,5" HorizontalAlignment="Right"
                                                Command="{Binding CheckReadinessCommand}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding ReadinessChecks}" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Marker}" FontSize="10"
                                                               FontWeight="SemiBold" Width="38"
                                                               Foreground="{Binding Ok, Converter={StaticResource BoolStatusBrush}}"
                                                               VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}" FontSize="11.5"
                                                                   Foreground="{StaticResource TextBrush}" />
                                                        <TextBlock Text="{Binding Detail}" FontSize="10.5"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Run Check readiness to populate this list."
                                               Foreground="#FF5B5B66" FontSize="10.5" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Action bar -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="CONTROLS" Style="{StaticResource Label}" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="CONNECT DEVICE" Style="{StaticResource GhostButton}"
                                            Command="{Binding ConnectDeviceCommand}" Margin="0,0,8,8" />
                                    <Button Content="CHECK READINESS" Style="{StaticResource GhostButton}"
                                            Command="{Binding CheckReadinessCommand}" Margin="0,0,8,8" />
                                    <Button Content="SYNC NTP" Style="{StaticResource GhostButton}"
                                            Command="{Binding SyncTimeCommand}" Margin="0,0,8,8" />
                                    <Button Content="OPEN XIAOMI COMMUNITY" Style="{StaticResource GhostButton}"
                                            Command="{Binding OpenCommunityCommand}" Margin="0,0,8,8" />
                                    <Button Content="PREPARE AUTOMATION" Style="{StaticResource GhostButton}"
                                            Command="{Binding PrepareAutomationCommand}" Margin="0,0,8,8" />
                                    <Button Content="ARM SCHEDULER" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding ArmSchedulerCommand}" Margin="0,0,8,8" />
                                    <Button Content="CANCEL SCHEDULER" Style="{StaticResource GhostButton}"
                                            Command="{Binding CancelSchedulerCommand}" Margin="0,0,8,8" />
                                    <Button Content="EMERGENCY STOP" Style="{StaticResource DangerButton}"
                                            Command="{Binding TriggerEmergencyStopCommand}" Margin="0,0,8,8" />
                                    <Button Content="Clear stop" Style="{StaticResource GhostButton}"
                                            Command="{Binding ClearEmergencyStopCommand}" Padding="12,9"
                                            Margin="0,0,8,8" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ HISTORY ============ -->
                <Grid Margin="26,22,26,24"
                      Visibility="{Binding IsHistory, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="AUDIT TRAIL" Style="{StaticResource Label}"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="Execution history" Style="{StaticResource PageTitle}" Margin="0,4,0,0" />
                            <TextBlock Text="Every attempt with its timestamps, uncertainty and evidence path."
                                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="EXPORT CSV" Style="{StaticResource GhostButton}"
                                    Command="{Binding ExportCsvCommand}" Margin="0,0,8,0" />
                            <Button Content="EXPORT JSON" Style="{StaticResource GhostButton}"
                                    Command="{Binding ExportJsonCommand}" Margin="0,0,8,0" />
                            <Button Content="EVIDENCE FOLDER" Style="{StaticResource GhostButton}"
                                    Command="{Binding OpenEvidenceFolderCommand}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
                        <DataGrid ItemsSource="{Binding History}" Style="{StaticResource DarkDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="BEIJING" Binding="{Binding Scheduled}" Width="205" />
                                <DataGridTextColumn Header="WIB" Binding="{Binding Jakarta}" Width="205" />
                                <DataGridTextColumn Header="RESULT" Binding="{Binding Result}" Width="120" />
                                <DataGridTextColumn Header="STATE" Binding="{Binding State}" Width="140" />
                                <DataGridTextColumn Header="CONF." Binding="{Binding Confidence}" Width="70" />
                                <DataGridTextColumn Header="MODE" Binding="{Binding Mode}" Width="130" />
                                <DataGridTextColumn Header="OFFSET" Binding="{Binding Offset}" Width="80" />
                                <DataGridTextColumn Header="UNCERT." Binding="{Binding Uncertainty}" Width="85" />
                                <DataGridTextColumn Header="EVIDENCE" Binding="{Binding Evidence}" Width="90" />
                                <DataGridTextColumn Header="NOTE" Binding="{Binding Note}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- ============ SETTINGS ============ -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsSettings, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="26,22,26,26">
                        <TextBlock Text="CONFIGURATION" Style="{StaticResource Label}"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Settings" Style="{StaticResource PageTitle}" Margin="0,4,0,0" />
                        <TextBlock Text="The default target stays 00:00:00 Asia/Shanghai (23:00 WIB the previous day)."
                                   Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,16" />

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="TARGET SCHEDULE" Style="{StaticResource SectionTitle}" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="TARGET HOUR (BEIJING)" Style="{StaticResource MiniLabel}" />
                                        <TextBox Style="{StaticResource DarkTextBox}"
                                                 Text="{Binding Settings.TargetHour, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="TARGET MINUTE" Style="{StaticResource MiniLabel}" />
                                        <TextBox Style="{StaticResource DarkTextBox}"
                                                 Text="{Binding Settings.TargetMinute, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="LATE GRACE (MS)" Style="{StaticResource MiniLabel}" />
                                        <TextBox Style="{StaticResource DarkTextBox}"
                                                 Text="{Binding Settings.LateGraceMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="If the target window is missed, the app refuses to submit late."
                                           Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="PRECISION AND SAFETY" Style="{StaticResource SectionTitle}" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="MAX NTP UNCERTAINTY (MS)" Style="{StaticResource MiniLabel}" />
                                        <TextBox Style="{StaticResource DarkTextBox}"
                                                 Text="{Binding Settings.MaxUncertaintyMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="XIAOMI COMMUNITY PACKAGE" Style="{StaticResource MiniLabel}" />
                                        <TextBox Style="{StaticResource DarkTextBox}"
                                                 Text="{Binding Settings.CommunityPackageId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <CheckBox Style="{StaticResource DarkCheckBox}" Margin="0,16,0,0"
                                          IsChecked="{Binding Settings.EnableEvidenceScreenshots, Mode=TwoWay}"
                                          Content="Capture a screenshot for every attempt (evidence)" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="EXECUTION MODE" Style="{StaticResource SectionTitle}" />
                                <StackPanel Margin="0,12,0,0">
                                    <RadioButton GroupName="Mode" Foreground="{StaticResource TextBrush}" Margin="0,4"
                                                 Content="Controlled ADB automation (primary)"
                                                 IsChecked="{Binding Settings.ExecutionMode, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter=ControlledAdb}" />
                                    <RadioButton GroupName="Mode" Foreground="{StaticResource TextBrush}" Margin="0,4"
                                                 Content="Manual assisted fallback"
                                                 IsChecked="{Binding Settings.ExecutionMode, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter=ManualAssisted}" />
                                    <RadioButton GroupName="Mode" Foreground="{StaticResource TextBrush}" Margin="0,4"
                                                 Content="Monitoring only (never submits)"
                                                 IsChecked="{Binding Settings.ExecutionMode, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter=Monitoring}" />
                                </StackPanel>
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="ADB EXECUTABLE (OPTIONAL)" Style="{StaticResource MiniLabel}" />
                                    <TextBox Style="{StaticResource DarkTextBox}"
                                             Text="{Binding Settings.AdbPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="SAVE SETTINGS" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SaveSettingsCommand}" />
                            <Button Content="OPEN LOG FOLDER" Style="{StaticResource GhostButton}"
                                    Command="{Binding OpenLogFolderCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ DIAGNOSTICS ============ -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsDiagnostics, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="26,22,26,26">
                        <TextBlock Text="INSPECTION" Style="{StaticResource Label}"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Diagnostics" Style="{StaticResource PageTitle}" Margin="0,4,0,0" />
                        <TextBlock Text="Read-only inspection of the device screen and the live event log."
                                   Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,16" />

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="SCREEN RECOGNITION" Style="{StaticResource SectionTitle}" />
                                    <Button Content="INSPECT CURRENT SCREEN" Style="{StaticResource GhostButton}"
                                            HorizontalAlignment="Right" Command="{Binding InspectScreenCommand}" />
                                </Grid>
                                <UniformGrid Columns="4" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="DETECTED SCREEN" Style="{StaticResource MiniLabel}" />
                                        <TextBlock Text="{Binding DiagnosticScreen}" Style="{StaticResource Value}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="VISIBLE NODES" Style="{StaticResource MiniLabel}" />
                                        <TextBlock Text="{Binding DiagnosticNodeCount}" Style="{StaticResource MonoValue}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="SUBMIT BUTTON" Style="{StaticResource MiniLabel}" />
                                        <TextBlock Text="{Binding DiagnosticButton}" Style="{StaticResource Value}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="EVIDENCE" Style="{StaticResource MiniLabel}" />
                                        <TextBlock Text="{Binding DiagnosticScreenshot}" Style="{StaticResource Value}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="FASTBOOT" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="{Binding FastbootStatus}" Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11.5" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Content="CHECK FASTBOOT" Style="{StaticResource GhostButton}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Command="{Binding CheckFastbootCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="LIVE EVENT LOG" Style="{StaticResource SectionTitle}" />
                                    <Button Content="OPEN LOG FOLDER" Style="{StaticResource GhostButton}"
                                            HorizontalAlignment="Right" Command="{Binding OpenLogFolderCommand}" />
                                </Grid>
                                <ListBox ItemsSource="{Binding LogLines}" Background="Transparent" BorderThickness="0"
                                         ItemContainerStyle="{StaticResource LogItem}" Margin="0,10,0,0"
                                         Height="260" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ MI UNLOCK ============ -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsMiUnlock, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="26,22,26,26">
                        <TextBlock Text="BOOTLOADER" Style="{StaticResource Label}"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Mi Unlock Tool" Style="{StaticResource PageTitle}" Margin="0,4,0,0" />
                        <TextBlock Text="Assistance for the official unlock step after authorization is granted."
                                   Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,16" />

                        <Border Background="#1AFF3B30" BorderBrush="#66FF3B30" BorderThickness="1"
                                CornerRadius="12" Padding="16,14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="MANDATORY WARNING" FontSize="11" FontWeight="Bold"
                                           Foreground="#FFFF6B62" />
                                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="19" Margin="0,6,0,0"
                                           Foreground="#FFE8B4B0"
                                           Text="Bootloader unlocking normally ERASES ALL USER DATA. Back up photos, messages and files first. This tool never enters credentials, never bypasses the waiting period, and never performs the destructive unlock on its own." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="FASTBOOT CONNECTION" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="{Binding FastbootStatus}" Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11.5" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Content="CHECK FASTBOOT" Style="{StaticResource GhostButton}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Command="{Binding CheckFastbootCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="OFFICIAL MI UNLOCK TOOL" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Download only from Xiaomi's official page, then point the app at the executable."
                                           Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="0,4,0,12" />
                                <TextBox Style="{StaticResource DarkTextBox}" Margin="0,0,0,10"
                                         Text="{Binding MiUnlockToolPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="BROWSE EXECUTABLE" Style="{StaticResource GhostButton}"
                                            Command="{Binding BrowseMiUnlockToolCommand}" Margin="0,0,8,0" />
                                    <Button Content="OPEN DOWNLOAD PAGE" Style="{StaticResource GhostButton}"
                                            Command="{Binding OpenXiaomiDownloadPageCommand}" Margin="0,0,8,0" />
                                    <Button Content="LAUNCH (CONFIRMATION REQUIRED)" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding LaunchMiUnlockToolCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="OFFICIAL WORKFLOW" Style="{StaticResource SectionTitle}" />
                                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="21" Margin="0,10,0,0"
                                           Foreground="{StaticResource MutedBrush}">
                                    <Run Text="1. Wait until Xiaomi Community confirms the authorization (do not unlock before it)." /><LineBreak />
                                    <Run Text="2. Bind the Xiaomi account to the device in Settings → Additional settings → Developer options → Mi Unlock status." /><LineBreak />
                                    <Run Text="3. Complete the mandatory waiting period shown in Mi Unlock Tool. It cannot be shortened." /><LineBreak />
                                    <Run Text="4. Back up all data, then boot into fastboot (Volume Down + Power) and connect USB." /><LineBreak />
                                    <Run Text="5. Confirm the device is listed, launch the official tool and follow its prompts on the phone." />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ ABOUT ============ -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsAbout, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="26,22,26,26" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="PRODUCT" Style="{StaticResource Label}"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="POCO Unlock Timing Assistant" Style="{StaticResource PageTitle}"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="Version 0.1.0 · Windows x64 · .NET 10 · WPF" Foreground="{StaticResource MutedBrush}"
                                   FontSize="12" Margin="0,4,0,16" />

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <TextBlock Text="{Binding AboutText}" TextWrapping="Wrap" FontSize="12.5" LineHeight="21"
                                       Foreground="{StaticResource TextBrush}" />
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="GUARANTEES AND LIMITS" Style="{StaticResource SectionTitle}" />
                                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="21" Margin="0,10,0,0"
                                           Foreground="{StaticResource MutedBrush}">
                                    <Run Text="· A completed ADB command is never reported as an approved authorization." /><LineBreak />
                                    <Run Text="· Ambiguous or unknown responses block automatic retries." /><LineBreak />
                                    <Run Text="· One attempt can send at most one submission action." /><LineBreak />
                                    <Run Text="· CAPTCHA, account verification and quota rules are never bypassed." /><LineBreak />
                                    <Run Text="· Windows cannot execute while asleep or powered off; missed windows are not replayed." /><LineBreak />
                                    <Run Text="· Millisecond server-arrival accuracy cannot be guaranteed." />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ================= STATUS BAR ================= -->
        <Border Grid.Row="2" Background="#FF08080A" BorderBrush="#FF1A1A20" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Margin="0,0,8,0"
                             Fill="{Binding StateKind, Converter={StaticResource StatusBrush}}" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11.5"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="900" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TargetLabel}" FontSize="10.5"
                               Foreground="#FF5B5B66" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
