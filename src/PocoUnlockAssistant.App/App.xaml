<Application x:Class="PocoUnlockAssistant.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PocoUnlockAssistant.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <conv:StatusKindToBrushConverter x:Key="StatusBrush" />
            <conv:BoolToStatusBrushConverter x:Key="BoolStatusBrush" />
            <conv:EnumToBoolConverter x:Key="EnumEquals" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
